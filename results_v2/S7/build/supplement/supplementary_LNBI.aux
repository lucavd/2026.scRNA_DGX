\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Memory at benchmark scale}{12}{subsection.3.5}\protected@file@percent }
\newlabel{memory-at-benchmark-scale}{{3.5}{12}{Memory at benchmark scale}{subsection.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Peak memory usage across dataset sizes, mean of five repeats (first repeat included); error bars: SD. Left: CPU RAM; right: aggregate GPU VRAM summed over the allocated devices (for 2, 4 and 8 GPUs dominated by the RMM pools pre-allocated by each Dask worker). CPU RAM grows roughly linearly; GPU VRAM is approximately constant for single-GPU runs due to RMM pool pre-allocation. All repeats of a configuration ran in one process; in the multi-GPU runs VRAM grew from the first to later repeats.}}{13}{figure.2}\protected@file@percent }
\newlabel{fig:S2}{{S2}{13}{Peak memory usage across dataset sizes, mean of five repeats (first repeat included); error bars: SD. Left: CPU RAM; right: aggregate GPU VRAM summed over the allocated devices (for 2, 4 and 8 GPUs dominated by the RMM pools pre-allocated by each Dask worker). CPU RAM grows roughly linearly; GPU VRAM is approximately constant for single-GPU runs due to RMM pool pre-allocation. All repeats of a configuration ran in one process; in the multi-GPU runs VRAM grew from the first to later repeats}{figure.2}{}}
